# QueueFlow Server Environment Configuration

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
JWT_SECRET=queueflow_super_secret_jwt_key_2026_dev

# PostgreSQL Configuration
# Optional: Provide standard connection string or individual credentials
# If PostgreSQL is not installed/running locally, QueueFlow automatically
# runs an embedded in-memory PostgreSQL engine (pg-mem) for instant testing!
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/queueflow
DB_HOST=localhost
DB_PORT=5432
DB_NAME=queueflow
DB_USER=postgres
DB_PASSWORD=postgres
